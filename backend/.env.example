GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# small / base / medium — modelo de faster-whisper a descargar la primera vez
WHISPER_MODEL=small

# Ruta a un modelo .onnx de Piper en español (descargar de
# https://github.com/rhasspy/piper/blob/master/VOICES.md)
PIPER_MODEL_PATH=./models/es_ES-voice.onnx
