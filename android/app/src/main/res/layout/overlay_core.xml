<?xml version="1.0" encoding="utf-8"?>
<!-- Variante "Isla superior" (tablero de diseño, variante B). El paddingTop real lo
     pone OverlayService según la altura de la barra de estado. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:id="@+id/overlayBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:background="@drawable/overlay_island_bg"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.dmcore.core.overlay.VoiceOrbView
                android:id="@+id/voiceOrb"
                android:layout_width="50dp"
                android:layout_height="50dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.22"
                        android:text="@string/overlay_wordmark"
                        android:textColor="@color/core_text"
                        android:textSize="10.5sp" />

                    <View
                        android:id="@+id/stateDot"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/state_dot" />

                    <TextView
                        android:id="@+id/stateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="@string/overlay_state_listening"
                        android:textAllCaps="true"
                        android:textColor="@color/core_red"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- Lo que dijo el usuario: en vivo mientras habla, después como cita. -->
                <TextView
                    android:id="@+id/queryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="start"
                    android:singleLine="true"
                    android:textColor="@color/core_text_dim"
                    android:textSize="12.5sp"
                    android:visibility="gone"
                    tools:text="“Jupiter, recuérdame llamar a Carlos a las 5”"
                    tools:visibility="visible" />
            </LinearLayout>

            <com.dmcore.core.overlay.WaveBarsView
                android:id="@+id/waveBars"
                android:layout_width="27dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="54dp"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/transcriptText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:maxLines="6"
                android:textColor="@color/core_text"
                android:textSize="15.5sp"
                tools:text="Listo. Te aviso a las 5:00 p. m. para llamar a Carlos." />

            <LinearLayout
                android:id="@+id/thinkingDots"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/state_dot" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/state_dot" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/state_dot" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
